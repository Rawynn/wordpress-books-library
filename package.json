{
  "name": "public",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:blocks": "wp-scripts start --webpack-copy-php --source-path=wp-content/plugins/books-library/src --output-path=wp-content/plugins/books-library/build",
    "build:blocks": "wp-scripts build --webpack-copy-php --source-path=wp-content/plugins/books-library/src --output-path=wp-content/plugins/books-library/build",
    "sass:plugin": "sass --watch --style=expanded wp-content/plugins/books-library/assets/scss/main.scss:wp-content/plugins/books-library/assets/css/main.css",
    "sass:plugin:build": "sass --style=compressed --no-source-map wp-content/plugins/books-library/assets/scss/main.scss:wp-content/plugins/books-library/assets/css/main.css",
    "sass:theme": "sass --watch --style=expanded wp-content/themes/twentytwentyfive-child/assets/scss/main.scss:wp-content/themes/twentytwentyfive-child/assets/css/main.css",
    "sass:theme:build": "sass --style=compressed --no-source-map wp-content/themes/twentytwentyfive-child/assets/scss/main.scss:wp-content/themes/twentytwentyfive-child/assets/css/main.css",
    "start": "npm-run-all --parallel start:blocks sass:plugin sass:theme",
    "build": "npm run build:blocks && npm run sass:plugin:build && npm run sass:theme:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rawynn/wordpress-books-library.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Rawynn/wordpress-books-library/issues"
  },
  "homepage": "https://github.com/Rawynn/wordpress-books-library#readme",
  "devDependencies": {
    "@wordpress/scripts": "^31.6.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.3"
  }
}